# Environment files with secrets
.env

# Docker volumes (managed by Docker, not in repo)
data/

# Database backups (these are large and should not be versioned)
backups/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
*.swp

# Python
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Logs (if any are generated)
*.log
logs/

# Test coverage reports (if you use pytest-cov or similar)
.coverage
htmlcov/
.coverage.*
coverage.xml

# Type checking caches (mypy, pyright, etc.)
.mypy_cache/
.pyright_cache/

# Distribution / build artifacts
dist/
build/
*.whl

# Generated documentation (if any)
docs/_build/
# Environment variants (the template stays tracked)
.env.*
!.env.example

# Private build and host facts (ADR-017). Backed up by scripts/backup.sh;
# docs/simpro/private-notes.template.md lists what belongs here.
docs/simpro/private/

# Host copies of tracked templates, holding real values (ADR-017)
deploy/**/*.local

# Data artefacts that must never be committed
*.csv
*.xlsx
*.xls
*.parquet
*.pkl
*.sqlite
*.sqlite3
*.db
*.dump
exports/
dumps/
uploads/
chroma/
vectorstore/
.ipynb_checkpoints/

# Evaluation questions and results come from CVC documents (ADR-017; W4).
# The runner, README, example set and value-free summaries stay tracked.
evaluation/eval-set.yaml
evaluation/results/
