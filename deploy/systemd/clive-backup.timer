# Daily trigger for clive-backup.service. Installed to /etc/systemd/system/;
# see docs/installation.md section 9.
#
# 02:30 avoids the other nightly jobs on the host and both UK clock changes
# (01:00-02:00). Persistent=true runs a missed backup at the next boot.

[Unit]
Description=Daily CLIVE backup at 02:30

[Timer]
OnCalendar=*-*-* 02:30:00
Persistent=true

[Install]
WantedBy=timers.target
