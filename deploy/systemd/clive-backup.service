# CLIVE cross-disk backup. Installed to /etc/systemd/system/ and started by
# clive-backup.timer; see docs/installation.md section 9 and
# docs/recovery-plan.md section 8.
#
# Runs scripts/backup.sh from the repository working tree, so the script on the
# checked-out branch is the one that runs. A failed backup exits non-zero and
# leaves this unit failed: `systemctl status clive-backup.service`,
# `journalctl -u clive-backup`.

[Unit]
Description=CLIVE cross-disk backup (scripts/backup.sh)
Documentation=file://<repo-dir>/docs/recovery-plan.md
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=<user>
Group=<user>
WorkingDirectory=<repo-dir>
ExecStart=<repo-dir>/scripts/backup.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
